/**
 * Implements hook_element_info_alter.
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function ambientimpact_base_element_info_alter(array &$info): void {

  \Drupal::classResolver(DetailsHooks::class)->elementInfoAlter($info);

  \Drupal::classResolver(FormElementHooks::class)->elementInfoAlter($info);

  \Drupal::classResolver(TableHooks::class)->elementInfoAlter($info);

}

/**
 * Implements hook_theme_suggestions_HOOK_alter.
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function ambientimpact_base_theme_suggestions_input_alter(
  array &$suggestions, array $variables,
): void {

  \Drupal::classResolver(FormElementHooks::class)->themeSuggestionsInputAlter(
    $suggestions, $variables,
  );

}

/**
 * Implements hook_theme_suggestions_HOOK_alter.
